{
  "name": "@super-productivity/plugin-dev",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "description": "Plugin development workspace for Super Productivity",
  "private": true,
  "scripts": {
    "build": "node scripts/build-all.js",
    "build:all": "node scripts/build-all.js",
    "build:all:silent": "node scripts/build-all.js --silent",
    "clean": "rm -rf node_modules */node_modules */dist",
    "clean:dist": "rm -rf */dist",
    "install:all": "npm ci",
    "test": "echo 'No tests configured yet'",
    "test:integrations": "vitest run github-issue-provider/src/plugin.spec.ts linear-issue-provider/src/plugin.spec.ts trello-issue-provider/src/plugin.spec.ts",
    "list": "echo 'Available plugins:' && ls -d */ | grep -v node_modules | grep -v scripts"
  },
  "workspaces": [
    "*"
  ]
}

{
  "id": "ms-todo-import",
  "manifestVersion": 1,
  "name": "Import from Microsoft To Do",
  "version": "1.0.0",
  "minSupVersion": "0.4.0",
  "description": "One-time import of your open Microsoft To Do lists, tasks, steps, notes, due dates and repeats. Additive \u2014 your existing Ultra Tasks data is never touched.",
  "author": "SuperProductivity",
  "homepage": "https://github.com/super-productivity/super-productivity",
  "hooks": [],
  "permissions": [
    "oauth",
    "getTasks",
    "getAllProjects",
    "addProject",
    "getAllTags",
    "addTag",
    "batchUpdateForProject",
    "updateTask",
    "addTaskRepeatCfg",
    "showSnack"
  ],
  "dataSharing": [
    {
      "recipient": "Microsoft",
      "hosts": ["login.microsoftonline.com", "graph.microsoft.com"],
      "data": ["credentials"],
      "privacyPolicyUrl": "https://privacy.microsoft.com/privacystatement"
    }
  ],
  "iFrame": true,
  "isSkipMenuEntry": true,
  "i18n": {
    "languages": ["en"]
  },
  "icon": "icon.svg"
}

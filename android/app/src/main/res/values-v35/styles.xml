<?xml version="1.0" encoding="utf-8"?>
<resources>

  <!--
    A qualified resource REPLACES the style of the same name, it does not merge
    with it, so this AppTheme must carry every item of values/styles.xml (and
    AppTheme.NoActionBarLaunch inherits it through its dotted name). With only
    the opt-out here, API 35+ lost statusBarColor and cold-started with the
    AppCompat default dark-blue status bar until the StatusBar plugin loaded.
    Keep the two files in step.
  -->
  <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
    <!-- Customize your theme here. -->
    <item name="colorPrimary">@color/primary</item>
    <item name="colorPrimaryDark">@color/primaryDark</item>
    <item name="colorAccent">@color/accent</item>
    <item name="android:statusBarColor">@color/statusBar</item>
    <item name="android:navigationBarColor">@color/navigationBar</item>
    <!-- only way to overwrite this it seems ... -->
    <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
  </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <cloud-backup>
    <!-- Prevent restored legacy launch_mode from pinning fresh installs to online mode. -->
    <exclude
      domain="sharedpref"
      path="com.superproductivity.superproductivity_preferences.xml" />
    <!-- Keystore-bound ciphertext; see backup_rules.xml. -->
    <exclude
      domain="sharedpref"
      path="SuperProductivitySync.xml" />
    <exclude domain="sharedpref" path="UltraNativeAccountV2.xml" />
    <!-- Per-device WebView verdict; see backup_rules.xml. -->
    <exclude
      domain="sharedpref"
      path="webview_compatibility.xml" />
    <!-- Device-bound tracking session; see backup_rules.xml. -->
    <exclude
      domain="sharedpref"
      path="SuperProductivityTracking.xml" />
    <!--
      Decrypted reminder, widget and shared/captured content (including titles of
      E2EE project tasks) lives in these files in plaintext. Keep it out of cloud
      backup, adb backup and device transfer; it is rebuilt from sync on next run.
    -->
    <exclude domain="sharedpref" path="SuperProductivityAlarms.xml" />
    <exclude domain="sharedpref" path="SuperProductivityWidget.xml" />
    <exclude domain="sharedpref" path="SuperProductivityWidgetDone.xml" />
    <exclude domain="sharedpref" path="SuperProductivityShare.xml" />
    <exclude domain="sharedpref" path="SuperProductivityCapture.xml" />
  </cloud-backup>
  <device-transfer>
    <!-- A transferred fresh install should select launch mode from current state. -->
    <exclude
      domain="sharedpref"
      path="com.superproductivity.superproductivity_preferences.xml" />
    <!-- Keystore-bound ciphertext; see backup_rules.xml. -->
    <exclude
      domain="sharedpref"
      path="SuperProductivitySync.xml" />
    <exclude domain="sharedpref" path="UltraNativeAccountV2.xml" />
    <!-- Per-device WebView verdict; see backup_rules.xml. -->
    <exclude
      domain="sharedpref"
      path="webview_compatibility.xml" />
    <!-- Device-bound tracking session; see backup_rules.xml. -->
    <exclude
      domain="sharedpref"
      path="SuperProductivityTracking.xml" />
    <!--
      Decrypted reminder, widget and shared/captured content (including titles of
      E2EE project tasks) lives in these files in plaintext. Keep it out of cloud
      backup, adb backup and device transfer; it is rebuilt from sync on next run.
    -->
    <exclude domain="sharedpref" path="SuperProductivityAlarms.xml" />
    <exclude domain="sharedpref" path="SuperProductivityWidget.xml" />
    <exclude domain="sharedpref" path="SuperProductivityWidgetDone.xml" />
    <exclude domain="sharedpref" path="SuperProductivityShare.xml" />
    <exclude domain="sharedpref" path="SuperProductivityCapture.xml" />
  </device-transfer>
</data-extraction-rules>

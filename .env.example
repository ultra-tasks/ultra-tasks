# Environment configuration example
# Copy this file to .env and adjust values as needed

# Example API keys and tokens (add your actual values in .env)
# GOOGLE_DRIVE_TOKEN=your-token-here
# DROPBOX_API_KEY=your-api-key-here
# UNSPLASH_KEY=your-api-key-here
# WEBDAV_URL=https://your-webdav-server.com
# WEBDAV_USERNAME=your-username
# WEBDAV_PASSWORD=your-password

# Public account server origin used as the client's initial sign-in address.
# ULTRA_ACCOUNT_URL=https://your-account-server.example
# Keep backend operator secrets in ultra-tasks-server/deploy/.env.
